PORT=5000
NODE_ENV=development
DATABASE_URL="sqlserver://localhost:1433;database=EBeautyDB;user=sa;password=YourPassword123;trustServerCertificate=true"

JWT_SECRET="ebeauty_jwt_secret_key_2026_super_secure"
JWT_REFRESH_SECRET="ebeauty_jwt_refresh_secret_key_2026_super_secure"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

UPLOAD_DIR="uploads"
BASE_URL="http://localhost:5000"

# SMTP Email Configuration (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@ebeauty.com"
SMTP_PASS="smtp_password_placeholder"
FROM_EMAIL="E-Beauty Store <noreply@ebeauty.com>"

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID="AC_twilio_sid_placeholder"
TWILIO_AUTH_TOKEN="twilio_auth_token_placeholder"
TWILIO_PHONE_NUMBER="+18005550199"

# Web Push Configuration
VAPID_PUBLIC_KEY="vapid_public_key_placeholder"
VAPID_PRIVATE_KEY="vapid_private_key_placeholder"
VAPID_EMAIL="mailto:admin@ebeauty.com"

# Admin Inventory Alert Threshold
LOW_STOCK_THRESHOLD=10
